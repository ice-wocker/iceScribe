<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 固定深色：录音类应用长时间握持，冷色深底更耐看，也不跟系统亮色打架 -->
    <style name="Theme.IceScribe" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:textColorHint">@color/text_faint</item>
    </style>

    <style name="Title" parent="@android:style/TextAppearance.Material.Title">
        <item name="android:textColor">@color/text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="Subtitle" parent="@android:style/TextAppearance.Material.Caption">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="SectionTitle" parent="@android:style/TextAppearance.Material.Subhead">
        <item name="android:textColor">@color/text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Chip" parent="@android:style/Widget.Material.Button.Borderless.Small">
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Chip.Primary">
        <item name="android:background">@drawable/bg_pill_primary</item>
        <item name="android:textColor">@color/black</item>
    </style>
</resources>